# NexusTrace Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================
# IP Analysis Services
# ============================================

# VPNapi.io - VPN/Proxy/Tor detection
# Get key at: https://vpnapi.io/
VPNAPI_KEY=

# IPinfo.io - IP geolocation and ASN data
# Get token at: https://ipinfo.io/account/token
IPINFO_TOKEN=

# Shodan - Port scanning and service detection
# Get key at: https://account.shodan.io/
SHODAN_KEY=

# AbuseIPDB - IP abuse/threat reporting
# Get key at: https://www.abuseipdb.com/account/api
ABUSEIPDB_KEY=

# ProxyCheck.io - Proxy/VPN detection (optional)
# Get key at: https://proxycheck.io/dashboard
PROXYCHECK_KEY=

# IP2Location.io - IP geolocation (optional)
# Get key at: https://www.ip2location.io/
IP2LOCATION_KEY=

# ============================================
# Domain/URL Analysis Services
# ============================================

# IP2WHOIS - WHOIS lookups
# Get key at: https://www.ip2whois.com/
IP2WHOIS_KEY=

# URLscan.io - URL scanning and screenshot
# Get key at: https://urlscan.io/user/profile/
URLSCAN_API_KEY=

# ============================================
# File/Hash Analysis Services
# ============================================

# VirusTotal - Malware detection (hash lookups)
# Get key at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# ============================================
# Threat Intelligence Services
# ============================================

# AlienVault OTX - Threat intelligence
# Get key at: https://otx.alienvault.com/api
# Note: Works with any of these variable names (checked in this order)
ALIENVAULT_KEY=
# ALIENVAULT=
# OTX_API_KEY=

# abuse.ch - ONE key for all of their services
# Register once at: https://auth.abuse.ch/
# Covers MalwareBazaar (file hashes), ThreatFox (IPs, domains, URLs, hashes),
# URLhaus (URLs and hosts), and the Hunting API. As of 2026 the Auth-Key header is
# MANDATORY on every one of them - without it MalwareBazaar returns 401 and the
# source reports as unavailable rather than "nothing known".
ABUSECH_AUTH_KEY=

# ============================================
# Optional: Offline Database
# ============================================

# Path to IPinfo MMDB file for offline lookups
# Download from: https://ipinfo.io/lite
# MMDB_PATH=/path/to/ipinfo_lite.mmdb

# ============================================
# Cloudflare Administration (optional)
# ============================================
# Only needed if you use scripts/cloudflare_admin.py to manage DNS,
# WAF rules, or rate limits from the command line. Leave blank to skip.

# Cloudflare API token - create at https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:Read, DNS:Edit, Firewall Rules:Edit, Zone Settings:Edit
CF_API_TOKEN=

# Zone ID for your domain
# Find it: Cloudflare dashboard → your domain → Overview → right sidebar
CF_ZONE_ID=

# Your root domain (e.g. example.com, mycompany.net)
CF_BASE_DOMAIN=

# The subdomain managed by cloudflare_admin.py (default: cloud)
CF_SUBDOMAIN=cloud

# ============================================
# Server Configuration
# ============================================

# Flask secret key - REQUIRED. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Debug mode (set to False in production)
FLASK_DEBUG=False

# Set to true only when running behind HTTPS (leave false for HTTP/internal deployments)
SECURE_COOKIES=false

# Server host and port
FLASK_HOST=0.0.0.0
FLASK_PORT=5050

# PORT is NOT set here. It is the managed-platform convention (Cloud Run injects
# PORT=8080) and it takes precedence over FLASK_PORT in both main.py and the
# Dockerfile CMD. Setting it in .env would override FLASK_PORT locally and break
# the 5050:5050 mapping in docker-compose.yml.

# ============================================
# Storage backend (Cloud Run only)
# ============================================
# Leave these unset/local for dev, Docker Compose, and the VM deployment - scans,
# screenshots, e-mail analyses, submissions and quarantine all live on the bind-mounted
# ./data directory.
#
# On Cloud Run the container filesystem is in-memory and per-instance: anything written
# under data/ is charged against the instance's memory limit and disappears on the next
# revision, restart, or scale-down, and a second instance cannot see the first one's
# records. Set STORAGE_BACKEND=gcs there and give GCS_BUCKET a bucket the service
# account can write. See docs/cloud-run.md.
#   local = filesystem under ./data (default)
#   gcs   = Google Cloud Storage bucket named by GCS_BUCKET
STORAGE_BACKEND=local

# Bucket name only, no gs:// prefix (e.g. nexustrace-data-prod). Required when
# STORAGE_BACKEND=gcs, ignored otherwise.
GCS_BUCKET=
