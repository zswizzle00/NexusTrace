# NexusTrace environment configuration. Copy to .env and fill in the keys you have.
# Every provider key is optional: a service whose key is missing is skipped and its card
# simply does not render.

# IP analysis
# VPNapi.io, VPN/proxy/Tor detection: https://vpnapi.io/
VPNAPI_KEY=
# IPinfo.io, geolocation and ASN: https://ipinfo.io/account/token
IPINFO_TOKEN=
# Shodan, ports and service banners: https://account.shodan.io/
SHODAN_KEY=
# AbuseIPDB, abuse reporting: https://www.abuseipdb.com/account/api
ABUSEIPDB_KEY=
# ProxyCheck.io, proxy/VPN detection: https://proxycheck.io/dashboard
PROXYCHECK_KEY=
# IP2Location.io, geolocation: https://www.ip2location.io/
IP2LOCATION_KEY=

# Domain and URL analysis
# IP2WHOIS, WHOIS lookups: https://www.ip2whois.com/
IP2WHOIS_KEY=
# urlscan.io submissions: https://urlscan.io/user/profile/
URLSCAN_API_KEY=

# File and hash analysis
# VirusTotal, hash reputation: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Threat intelligence
# AlienVault OTX: https://otx.alienvault.com/api
# Any of these three names works, checked in this order.
ALIENVAULT_KEY=
# ALIENVAULT=
# OTX_API_KEY=

# ONE key for MalwareBazaar, ThreatFox, URLhaus and the Hunting API, from
# https://auth.abuse.ch/. The Auth-Key header is MANDATORY as of 2026; without it
# MalwareBazaar returns 401 and the source reports as unavailable rather than
# "nothing known".
ABUSECH_AUTH_KEY=

# IPinfo MMDB for offline lookups, from https://ipinfo.io/lite
# MMDB_PATH=/path/to/ipinfo_lite.mmdb

# Cloudflare administration, needed only by scripts/cloudflare_admin.py. Leave blank to
# skip. Setup and recovery: docs/cloudflare-admin.md.
# Token needs Zone:Read, DNS:Edit, Firewall Rules:Edit, Zone Settings:Edit.
CF_API_TOKEN=
CF_ZONE_ID=
# The `access` commands only. Access applications are account-scoped, so CF_ZONE_ID is
# not enough and the token also needs "Cloudflare Access: Apps and Policies | Edit".
CF_ACCOUNT_ID=
# Root domain (e.g. example.com), then the subdomain cloudflare_admin.py manages.
CF_BASE_DOMAIN=
CF_SUBDOMAIN=cloud

# Server configuration
# REQUIRED. Unset, or left as this placeholder, means a per-process random key, so
# sessions and CSRF tokens break on every restart and across instances.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Leave False. The URL scanner loads attacker-controlled pages, so an interactive
# debugger on a reachable port is a remote-code-execution surface.
FLASK_DEBUG=False

# true only behind HTTPS.
SECURE_COOKIES=false

FLASK_HOST=0.0.0.0
FLASK_PORT=5050

# PORT is deliberately NOT set here. It is a managed-platform convention (Cloud Run injects
# PORT=8080) and it takes precedence over FLASK_PORT in both main.py and the Dockerfile
# CMD, so a value in this file would break the 5050:5050 mapping in docker-compose.yml.

# Process role: 'public' (the default when unset) or 'admin'. Anything else refuses to
# start, because a typo that silently meant 'admin' would put the admin UI back on the
# internet. On 'public' the admin blueprint is never registered, so /admin is absent from
# the url_map and 404s; ADMIN_TOKEN does not resurrect it.
#
# DO NOT SET IT HERE. docker-compose.yml pins it per service and `environment` overrides
# `env_file`, so a value here is ignored under Compose and only misleads. It exists for
# direct `python main.py` runs. Reach the Compose admin service, published on
# 127.0.0.1:5051 only, with `ssh -L 5051:127.0.0.1:5051 <homelab-host>`.
# NEXUSTRACE_ROLE=public

# Activity dashboard (/admin, admin role only). The request log under data/activity/ is
# written on every deployment regardless; the three variables below only control who may
# READ it, and LEAVING THEM ALL UNSET DISABLES /admin ENTIRELY: it returns 404, identical
# to any unrouted path, so it is not discoverable. There is no default token. Keep
# authentication on even when unreachable from the internet: a homelab LAN includes IoT
# devices and anything else on it that gets compromised.

# Shared secret for /admin, submitted through the sign-in form or an X-Admin-Token header,
# never a query string, so it stays out of browser history and out of the activity log.
# Rotating it invalidates every existing admin session.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Comma-separated allowlist, checked against the VERIFIED Access JWT claim once
# CF_ACCESS_* are set. Not authentication on its own: the plaintext
# Cf-Access-Authenticated-User-Email header is never trusted, because anything that can
# reach the origin directly can set it.
ADMIN_EMAILS=

# Setting BOTH switches /admin to requiring a signed Access JWT and disables ADMIN_TOKEN.
# Setting only one denies everyone, the fail-closed reading of an operator mid-edit.
# Locked out? Unset both and restart to fall back to ADMIN_TOKEN, so keep that token
# strong. Read the values with `scripts/cloudflare_admin.py access show`.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Where the activity log is written. Defaults to data/activity/. Same sensitivity as
# data/analyses/: real client IPs tied to investigative actions.
# NEXUSTRACE_ACTIVITY_DIR=/var/lib/nexustrace/activity

# 'local' (filesystem under ./data) or 'gcs'. Leave it local for dev, Compose and the VM.
# On Cloud Run the container filesystem is in-memory and per-instance, so anything under
# data/ is charged against the memory limit, vanishes on restart, and is invisible to a
# second instance; use gcs there. See docs/cloud-run.md.
STORAGE_BACKEND=local

# Bucket name only, no gs:// prefix. REQUIRED when STORAGE_BACKEND=gcs: a gcs backend
# without it fails at construction rather than silently falling back to local.
GCS_BUCKET=
