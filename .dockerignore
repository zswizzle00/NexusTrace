# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
ENV/
env/
.env

# Tooling (downloaded on demand, never needed in the image)
tools/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Git
.git
.gitignore

# Deployment manifests. service.yaml is applied from the developer's machine, never read
# by the container, and it names the project's service account and secrets.
Dockerfile
docker-compose.yml
.dockerignore
service.yaml
nginx.conf

# Logs
logs/
*.log

# Local development
*.db
*.sqlite3
.DS_Store

# NOT optional: data/ is bind-mounted by docker-compose.yml, so a copy in the image is dead
# weight AND every new scan or screenshot busts the `COPY . .` layer and everything after
# it. The services mkdir their own store directories at import, so nothing here is needed
# at build time.
data/

# Agent scratch, planning docs, and host-side tooling: never served or imported.
.superpowers/
.worktrees/
docs/
tasks/
icon_tools/
.claude/
.github/
*.md
uv.lock
.publicignore
.nexustrace.pid
nexus_auto_update.sh
start.sh
stop.sh

# Tests run on the host: test_endpoints.py talks to the container over HTTP via
# NEXUSTRACE_BASE_URL.
app/tests/ 